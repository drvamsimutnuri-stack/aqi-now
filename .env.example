# Copy to .env.local and fill in. Everything here is optional — the app runs
# fully without any of it, using the Copernicus CAMS model via Open-Meteo.

# Ground-station readings from official reference monitors (India's CPCB, US
# AirNow, the EEA). Free key from https://explore.openaq.org/register — it
# appears at the bottom of the account settings page once your email is verified.
#
# Without this the app is model-only and the "Measured at the nearest monitors"
# comparison stays hidden. OpenAQ v3 requires a key; the old keyless v1/v2
# endpoints are retired.
OPENAQ_API_KEY=

# Canonical origin used for metadata, sitemap and robots.txt. Vercel sets this
# automatically in deployment, so it is only needed for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
